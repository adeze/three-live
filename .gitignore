# Dependencies
node_modules/

# Rust / Cargo build outputs
target/

# TypeScript / esbuild generated bundles
dist/
three-live/dist/
xr-live/dist/

# Generated example bundles & embedded assets (created by `npm run build`)
examples/three/three-live.js
three-live/examples/three-live.js
compiler/assets/three-author-engine.min.js

# Per-package LICENSE copies, created from the root LICENSE by `npm pack` /
# `npm publish` (`prepack`), so the license text lives in exactly one file.
three-live/LICENSE
xr-live/LICENSE

# Gradle wrapper binary, generated by scripts/bootstrap_gradle_wrapper.sh.
# Deliberately not checked in: it is a compiled artifact. The Gradle version is pinned in
# gradle/wrapper/gradle-wrapper.properties, and CI provisions that version explicitly.
gradle/wrapper/gradle-wrapper.jar
.gradle/
build/

# Apple build artifacts.
# scripts/build_ios_xcframework.sh writes the XCFramework into the source tree, and the
# release workflow zips it there. Both are compiled artifacts and must never be committed.
*.xcframework/
*.xcframework.zip

# Xcode project and Info.plist for the iOS example, generated from project.yml by XcodeGen.
mobile/examples/ios_swiftui/ThreeLiveDemo.xcodeproj/
mobile/examples/ios_swiftui/Info.plist
mobile/examples/macos_remote_immersive/ThreeLiveRemoteImmersive.xcodeproj/
mobile/examples/macos_remote_immersive/Info.plist
*.xcworkspace/
.swiftpm/
.build/

# OS / Editor files
.DS_Store
*.swp

# Android SDK location (machine-specific).
local.properties

# Local planning / parity notes (never committed to GitHub).
docs/xr-spatial-parity.md
docs/*-plan.md
